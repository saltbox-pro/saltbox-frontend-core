{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "declaration": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
      "saltbox-core-api": [
        "./node_modules/@saltbox/saltbox-core-api-client"
      ],
      "saltbox-core/*": [
        "src/*"
      ],
    }
  },
  "include": [
    "src/**/*"
  ]
}
